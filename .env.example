# --- Site
SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME="Aqua Iro Archive"

# --- Database (Neon). Local: point at the `dev` branch.
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require

# --- Security
IP_HASH_SECRET=                     # 64 random hex chars; base secret for IP hashing (monthly salt derived from it)
CRON_SECRET=                        # random; Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes
# Turnstile: local + CI use Cloudflare's documented testing keys
# (https://developers.cloudflare.com/turnstile/troubleshooting/testing/):
#   site key  "always passes" 1x00000000000000000000AA
#   secret    "always passes" 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Admin auth (Better Auth)
BETTER_AUTH_SECRET=                 # 32+ random bytes
BETTER_AUTH_URL=http://localhost:4321
ADMIN_EMAIL=                        # used by scripts/create-admin.ts only

# --- Analytics (Umami)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=/s/ui.js
PUBLIC_UMAMI_HOST=/s
PUBLIC_UMAMI_DOMAINS=aqua-iro-archive.vercel.app
UMAMI_API_URL=https://aqua-umami.vercel.app/api
UMAMI_API_USER=keeper-api
UMAMI_API_PASSWORD=

# --- Alerts
DISCORD_WEBHOOK_URL=

