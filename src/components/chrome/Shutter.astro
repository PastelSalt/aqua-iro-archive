---
/**
 * Chapter-change shutter (IMPROVEMENT-PLAN §1.5 Global). Two diagonal panels in the destination
 * chapter's colour close over its number and name, then open on the new page — an anime eyecatch.
 * The first visit to each chapter in a session holds for 600 ms on an official pose (skippable).
 * Persisted across ClientRouter swaps; driven by src/scripts/shutter.ts. Motion OFF: no shutter.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CHAPTERS } from '../../lib/chapters';
import { CHAPTER_ART } from '../../lib/chapter-art';

const poses = import.meta.glob<{ default: ImageMetadata }>('../../assets/poses/*.webp', { eager: true });
const data = Object.fromEntries(
  await Promise.all(
    CHAPTERS.map(async (c) => {
      const mod = poses[`../../assets/poses/${CHAPTER_ART[c.id].pose}.webp`];
      const img = mod ? await getImage({ src: mod.default, height: 360, format: 'webp', quality: 70 }) : null;
      return [
        c.href,
        { no: c.no, en: c.title.en, ja: c.title.ja, tint: c.tint, id: c.id, pose: img?.src ?? '' },
      ];
    }),
  ),
);
---

<div
  class="shutter"
  data-shutter
  data-chapters={JSON.stringify(data)}
  aria-hidden="true"
  transition:persist="shutter"
>
  <i class="shutter__panel shutter__panel--a"></i>
  <i class="shutter__panel shutter__panel--b"></i>
  <div class="shutter__card">
    <img class="shutter__pose" alt="" decoding="async" />
    <span class="shutter__no num"></span>
    <b class="shutter__en"></b>
    <span class="shutter__ja" lang="ja"></span>
    <small class="shutter__skip">
      <span data-l="ja" lang="ja">
        クリックでスキップ
      </span>
      <span data-l="en" lang="en">
        click to skip
      </span>
    </small>
  </div>
</div>
