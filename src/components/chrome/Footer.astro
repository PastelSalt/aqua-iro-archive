---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/channel.png';
import moekoworks from '../../assets/logo/moekoworks.png';
import signature from '../../assets/logo/signature.png';
import Seam from '../ui/Seam.astro';
import Icon from '../ui/Icon.astro';
import T from '../ui/T.astro';
import { CHAPTERS } from '../../lib/chapters';
import { PORTFOLIO, SISTER_SITES } from '../../lib/site';
interface Props {
  /** Home ends on its own farewell (with the signature), so its ending card skips it */
  signature?: boolean;
}
const { signature: showSignature = true } = Astro.props;
const THANKS = [
  'ありがとう、あくたん',
  'THANK YOU AKUTAN',
  'お疲れ様でした',
  'SEE YOU ⚓ またね',
  'あくあクルーより',
  'FROM THE AQUA CREW',
];
---

<div class="ending" aria-hidden="true">
  <Seam kind="wave" />
  <div class="ending__band">
    {showSignature && (
      <Image class="ending__sign" src={signature} alt="" width={280} loading="lazy" decoding="async" />
    )}
    <div class="ending__marquee">
      <div class="ending__track">
        {[0, 1].map(() => (
          <span class="ending__group">
            {THANKS.map((t) => (
              <>
                <span>{t}</span>
                <Icon name="heart" />
              </>
            ))}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
<footer class="footer">
  <div class="wrap">
    <div class="footer__inner">
      <div class="footer__brand">
        <Image src={logo} alt="湊あくあ Minato Aqua" width={300} />
        <p>
          <T k="unofficial" /> <T k="notAffiliated" />
        </p>
        <p>
          <T k="copyright" />
        </p>
        <a class="maker-card" href={PORTFOLIO.url} rel="noopener" target="_blank">
          <small>
            <span data-l="ja" lang="ja">
              制作
            </span>
            <span data-l="en" lang="en">
              Made by
            </span>
          </small>
          <Image src={moekoworks} alt="Moeko Works" height={44} densities={[1, 2]} />
          <span class="maker-card__go">
            <span data-l="ja" lang="ja">
              ほかの作品を見る
            </span>
            <span data-l="en" lang="en">
              See more work
            </span>{' '}
            ↗
          </span>
        </a>
      </div>
      <nav aria-labelledby="ft-archive">
        <h2 id="ft-archive">
          <T k="footer.archive" />
        </h2>
        <ul>
          {CHAPTERS.map((c) => (
            <li>
              <a href={c.href}>
                <span class="label">{c.no}</span> <span lang="ja">{c.title.ja}</span> ·{' '}
                <span lang="en">{c.title.en}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 id="ft-about">
          <T k="footer.about" />
        </h2>
        <ul>
          <li>
            <a href="/credits">
              <T k="footer.credits" />
            </a>
          </li>
          <li>
            <a href="/privacy">
              <T k="footer.privacy" />
            </a>
          </li>
          <li>
            <a href="/credits#removal">
              <T k="footer.removal" />
            </a>
          </li>
        </ul>
        <h2 style="margin-top:var(--s-5)">
          <T k="footer.sisters" />
        </h2>
        <ul class="sister-cards">
          {SISTER_SITES.map((s) => (
            <li>
              <a class="sister-card" href={s.url} rel="noopener" style={`--tint:${s.tint}`}>
                <span class="sister-card__mark" aria-hidden="true">
                  {s.mark}
                </span>
                <b>{s.name}</b>
                <small>
                  <span data-l="ja" lang="ja">
                    {s.note.ja}
                  </span>
                  <span data-l="en" lang="en">
                    {s.note.en}
                  </span>{' '}
                  ↗
                </small>
              </a>
            </li>
          ))}
          <li>
            <a class="sister-card" href={PORTFOLIO.url} rel="noopener">
              <Image class="sister-card__logo" src={moekoworks} alt="" height={28} densities={[1, 2]} />
              <b>{PORTFOLIO.name}</b>
              <small>
                <span data-l="ja" lang="ja">
                  制作者のサイト
                </span>
                <span data-l="en" lang="en">
                  The maker
                </span>{' '}
                ↗
              </small>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__fine">
      <a class="footer__by" href={PORTFOLIO.url} rel="noopener" target="_blank">
        <T k="footer.madeBy" /> · 2026 ↗
      </a>
      <a class="back-top" href="#top">
        <Icon name="arrow-up" /> <T k="footer.backTop" /> ⚓
      </a>
    </div>
  </div>
</footer>
