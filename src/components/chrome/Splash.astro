---
/**
 * Loading screen, "出航準備" → title screen (FULL-UPDATE-PLAN §B2). Three beats:
 *  1. studio card — 「制作 Moeko Works」 with the flowers blooming in (~600 ms; first-ever visit only);
 *  2. the harbour — her under-the-sea key visual, softly blurred; the logo, NOW LOADING bobbing like buoys,
 *     a tide gauge with the Moeko flower riding the waterline and the percentage, and TIPS in the Talk box
 *     in her voice, over a low band of the deep;
 *  3. a title screen (first-ever visit only, or a tour replay): the key visual comes into focus with her on
 *     the right and the logo on the left, and PRESS START, a version line and a copyright line on the deep.
 *     No menu: a website needs no "continue" or "config"; everything is in the dock. Between 2 and 3 the
 *     tide comes in over the screen and goes back out, like the page-switch shutter.
 * Leaving, the deep surges over the screen and drains away. Later sessions get beat 2 only (1.6–3.2 s).
 * Skip (▸▸, Esc) always works. html[data-splash=seen] hides it before paint. Motion OFF: still frames, no
 * studio beat, no tide. Lines are fan-written.
 */
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import channel from '../../assets/logo/channel.png';
import moekoworks from '../../assets/logo/moekoworks.png';
import MoekoFlower from '../ui/MoekoFlower.astro';
import { PORTFOLIO } from '../../lib/site';

// her alone, swimming with the fish: the harbour's sea, and the title screen's key visual
const kvArt = (await getEntry('arts', 'music-indoor-kei'))?.data.image;
const kv = kvArt ? await getImage({ src: kvArt, width: 1440, format: 'webp', quality: 60 }) : null;
const TIPS = [
  { ja: 'あてぃしの初配信は2018年8月8日！', en: 'My very first stream was on 8 August 2018!' },
  { ja: '寄せ書きボードには、だれでも一枚貼れるよ', en: 'Anyone can pin a note on the message board!' },
  {
    ja: '下のTIMEボタンで、六年間のどの日にも行けるよ',
    en: 'The TIME button below takes you to any day of the six years!',
  },
  {
    ja: 'ホームのテキストボックスを押すと、あてぃしとお話しできるよ',
    en: 'Press the text box on Home to talk with me!',
  },
  { ja: 'MOTIONを押すと、動きを止められるよ', en: 'Press MOTION to stop the animations.' },
];
---

<div class="splash" data-splash-root role="status" aria-live="polite" data-beat="load">
  <div class="splash__kv" aria-hidden="true" style={kv ? `background-image:url(${kv.src})` : undefined}></div>

  <!-- beat 1: the studio card -->
  <div class="splash__studio" aria-hidden="true">
    <div class="splash__studio-card">
      <MoekoFlower class="splash__bloom" />
      <small>
        <span lang="ja">制作</span> · presented by
      </small>
      <Image src={moekoworks} alt="" height={56} densities={[1, 2]} loading="eager" />
    </div>
  </div>

  <!-- beat 2: the harbour -->
  <div class="splash__load">
    <div class="splash__brand">
      <Image src={channel} alt="湊あくあ Minato Aqua Ch." width={320} densities={[1, 2]} loading="eager" />
      <small>AQUA IRO ARCHIVE</small>
    </div>
    <p class="splash__nowloading" aria-hidden="true">
      {[...'NOW LOADING'].map((c, i) => (
        <span style={`--i:${i}`}>{c === ' ' ? ' ' : c}</span>
      ))}
    </p>
    <!-- the tide gauge: the water is the progress, the flower rides its edge -->
    <div class="splash__gauge" aria-hidden="true">
      <i class="splash__gauge-water"></i>
      <span class="splash__marker">
        <MoekoFlower class="splash__marker-flower" />
      </span>
      <span class="splash__pct num" data-splash-pct>
        0%
      </span>
    </div>
    <p class="sr-only">
      <span data-l="ja" lang="ja">
        出航準備中…
      </span>
      <span data-l="en" lang="en">
        Setting sail…
      </span>
    </p>
    <div class="splash__tips aqua-wait__bubble" aria-hidden="true">
      <span class="aqua-wait__name">TIPS</span>
      {TIPS.map((t, i) => (
        <span class="splash__tip" data-tip={i} hidden={i > 0}>
          <span data-l="ja" lang="ja">
            {t.ja}
          </span>
          <span data-l="en" lang="en">
            {t.en}
          </span>
        </span>
      ))}
    </div>
  </div>

  <!-- the deep: a low band of sea; it comes in over the screen between beats and on leaving -->
  <div class="splash__sea" aria-hidden="true">
    <MoekoFlower one class="splash__petal" />
  </div>

  <!-- beat 3: the title screen -->
  <div class="splash__title" role="dialog" aria-modal="true" aria-label="Aqua Iro Archive" hidden>
    <div class="splash__title-logo">
      <Image src={channel} alt="湊あくあ Minato Aqua Ch." width={400} densities={[1, 2]} loading="lazy" />
      <b>AQUA IRO ARCHIVE</b>
      <span lang="ja">あくあ色アーカイブ</span>
    </div>
    <button type="button" class="splash__press" data-splash-start>
      PRESS START · クリックで出航
    </button>
    <small class="splash__ver num">ver. 2018.08.08 – 2024.08.28</small>
    <small class="splash__copy">
      © COVER Corp. · fan site by Moeko Works <MoekoFlower class="splash__copy-flower" />
    </small>
  </div>

  <a class="splash__by" href={PORTFOLIO.url} rel="noopener" target="_blank">
    <small>
      <span data-l="ja" lang="ja">
        制作
      </span>
      <span data-l="en" lang="en">
        Made by
      </span>
    </small>
    <Image src={moekoworks} alt="Moeko Works" height={40} densities={[1, 2]} loading="eager" />
  </a>
  <button type="button" class="btn btn--secondary splash__skip" data-splash-skip>
    <span data-l="ja" lang="ja">
      スキップ
    </span>
    <span data-l="en" lang="en">
      Skip
    </span>{' '}
    ▸▸
  </button>
</div>

<script>
  import { markSplashSeen } from '../../lib/prefs';
  import { KEYS, read, write } from '../../lib/storage';

  const MIN_MS = 1600; // long enough to read the logos, short enough not to be in the way
  const MAX_MS = 3200;
  const STUDIO_MS = 600;
  const TIP_MS = 1200;
  const root = document.querySelector<HTMLElement>('[data-splash-root]');
  const html = document.documentElement;
  if (root && html.dataset.splash !== 'seen') {
    const motion = () => html.dataset.motion === 'on';
    // the full version (studio card + title screen) on the first-ever visit, or when HELP replays the tour
    let replay = false;
    try {
      replay = sessionStorage.getItem(KEYS.replay) === '1';
    } catch {
      /* storage blocked */
    }
    const full = replay || !read<string | null>(KEYS.titleSeen, null);
    const pct = root.querySelector<HTMLElement>('[data-splash-pct]')!;
    const title = root.querySelector<HTMLElement>('.splash__title')!;
    const t0 = performance.now();
    let p = 0;
    let done = false;
    let leaving = false;
    const set = (v: number) => {
      p = Math.max(p, Math.min(100, v));
      root.style.setProperty('--p', String(p / 100));
      pct.textContent = `${Math.round(p)}%`;
    };
    // TIPS change every ~1.2 s while loading
    const tips = Array.from(root.querySelectorAll<HTMLElement>('[data-tip]'));
    let tipN = 0;
    const tipTick = setInterval(() => {
      tips[tipN]!.hidden = true;
      tipN = (tipN + 1) % tips.length;
      tips[tipN]!.hidden = false;
    }, TIP_MS);

    const leave = (then?: () => void) => {
      if (leaving) return;
      leaving = true;
      clearInterval(tick);
      clearInterval(tipTick);
      write(KEYS.titleSeen, '1');
      markSplashSeen();
      const end = () => {
        root.remove();
        then?.();
      };
      if (!motion()) {
        root.classList.add('is-done');
        setTimeout(end, 300);
        return;
      }
      // the deep surges over the screen, then drains up off it (the shutter's motion)
      root.classList.add('is-surge');
      setTimeout(() => root.classList.add('is-drain'), 300);
      setTimeout(end, 620);
    };

    const showTitle = () => {
      root.dataset.beat = 'title';
      title.hidden = false;
      // PRESS START is the one control: a click anywhere, Enter or Esc sets sail
      title.querySelector<HTMLButtonElement>('[data-splash-start]')!.focus();
      title.addEventListener('click', () => leave());
      title.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') leave();
        else if (e.key === 'Tab') e.preventDefault(); // nothing else to move to: focus stays put
      });
    };

    const finish = () => {
      if (done) return;
      done = true;
      clearInterval(tick);
      set(100);
      if (!full) return void setTimeout(() => leave(), motion() ? 280 : 0);
      if (!motion()) return showTitle();
      // the tide comes in over the harbour, and goes back out on the title screen
      setTimeout(() => {
        root.classList.add('is-tide');
        setTimeout(() => {
          showTitle();
          root.classList.remove('is-tide');
        }, 380);
      }, 240);
    };

    // the sea follows elapsed time (towards 92% at MIN_MS), and jumps ahead as real work completes
    const tick = setInterval(() => set(((performance.now() - t0) / MIN_MS) * 92), 80);
    const startLoad = () => {
      root.dataset.beat = 'load';
      const hero = document.querySelector<HTMLImageElement>('[data-hero-img]');
      Promise.all([
        document.fonts?.ready,
        hero ? hero.decode().catch(() => undefined) : Promise.resolve(),
      ]).then(() => setTimeout(finish, Math.max(250, MIN_MS - (performance.now() - t0))));
      setTimeout(finish, MAX_MS);
    };
    if (full && motion()) {
      root.dataset.beat = 'studio';
      setTimeout(startLoad, STUDIO_MS);
    } else startLoad();

    root.querySelector('[data-splash-skip]')?.addEventListener('click', () => leave());
    document.addEventListener('keydown', function esc(e) {
      if (e.key !== 'Escape' || !root.isConnected) return document.removeEventListener('keydown', esc);
      if (root.dataset.beat !== 'title') leave();
    });
  } else {
    root?.remove();
  }
</script>
