---
/**
 * Side rails (IMPROVEMENT-PLAN §1.3), shown only where the margins are wide enough (≥ 1440 px).
 * Left: a filmstrip of small official art frames that drifts upward (and a little faster while you
 * scroll). Right: the chapter's vertical title and a running progress number. Fixed behind the page
 * content, so full-width sections cover them and only the bare margins show them.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  frames: { image: ImageMetadata }[];
  title: string;
  no: string; // "04"
}
const { frames, title, no } = Astro.props;
const strip = frames.slice(0, 7);
---

<div class="rails" aria-hidden="true">
  <div class="rail rail--film">
    <div class="rail__strip">
      {[0, 1].map(() => (
        <div class="rail__set">
          {strip.map((f) => (
            <span class="rail__frame">
              <Image src={f.image} alt="" width={140} quality={55} loading="lazy" decoding="async" />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="rail rail--title">
    <span class="rail__no num">No.{no}</span>
    <span class="rail__vert">{title}</span>
    <span class="rail__progress num"></span>
  </div>
</div>
