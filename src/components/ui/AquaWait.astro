---
/**
 * "Aqua talks", compact (FULL-UPDATE-PLAN §A1): the Talk dialogue box at a smaller size with a fan-written
 * line in her voice, for loading, empty and error states. The small pose comes from --pose-wait; pages that
 * already show her large (the 404) pass pose={false}. Islands and scripts build the same markup by hand.
 */
interface Props {
  ja: string;
  en: string;
  pose?: boolean;
}
const { ja, en, pose = true } = Astro.props;
---

<div class="aqua-wait">
  {pose && <span class="aqua-wait__pose" aria-hidden="true" />}
  <p class="aqua-wait__bubble">
    <span class="aqua-wait__name" aria-hidden="true">
      あくあ <span>AQUA</span>
    </span>
    <span data-l="ja" lang="ja">
      {ja}
    </span>
    <span data-l="en" lang="en">
      {en}
    </span>
  </p>
</div>
