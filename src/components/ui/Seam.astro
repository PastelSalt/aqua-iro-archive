---
/**
 * Section seam (IMPROVEMENT-PLAN §1.3): the gap between two sections becomes a visual. Three kinds:
 * "wave" (two undulating wave bands), "ticker" (a tilted pink marquee), "rope" (a rope with bobbing
 * buoys). All motion is transform-only and stops with Motion OFF.
 */
interface Props {
  kind?: 'wave';
}
const { kind = 'wave' } = Astro.props;
// each wave is drawn over TWO viewBox widths (2400) inside a 200%-wide svg, so the -50% slide loops
// onto an identical copy; a single 1200 path stretched to 200% slid off and left hard-edged gaps
const wavePath = (y: number, amp: number, period: number) => {
  let d = `M0 ${y} Q ${period / 2} ${y - amp} ${period} ${y}`;
  for (let x = period * 2; x <= 2400; x += period) d += ` T ${x} ${y}`;
  return `${d} V60 H0Z`;
};
const BACK = wavePath(30, 30, 150);
const FRONT = wavePath(34, 26, 200);
---

{kind === 'wave' && (
  <div class="seam seam--wave" aria-hidden="true">
    <svg class="seam__wave seam__wave--back" viewBox="0 0 2400 60" preserveAspectRatio="none">
      <path d={BACK} />
    </svg>
    <svg class="seam__wave seam__wave--front" viewBox="0 0 2400 60" preserveAspectRatio="none">
      <path d={FRONT} />
    </svg>
  </div>
)}
