---
interface Props {
  name: string;
  class?: string;
  label?: string;
  style?: string;
}
const { name, class: cls = 'icon', label, style } = Astro.props;
---

<svg
  class={cls}
  style={style}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <use href={`#i-${name}`}></use>
</svg>
