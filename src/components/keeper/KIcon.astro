---
/** One Keeper icon from KeeperIcons.astro's sprite. Decorative unless `label` is given. */
interface Props {
  name: string;
  label?: string;
  class?: string;
}
const { name, label, class: cls } = Astro.props;
---

<svg
  class:list={['k-ico', cls]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <use href={`#k-${name}`}></use>
</svg>
