---
/** No.06 Arts — the VN "CG gallery" (EXECUTIONPLAN §9.6). Credit on every tile and in the viewer. */
import { Image, Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import Icon from '../components/ui/Icon.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import { ART_SECTIONS } from '../content.config';
import { dotDate } from '../lib/format';

const SECTION: Record<string, { ja: string; en: string }> = {
  outfits: { ja: '衣装', en: 'Outfits' },
  'key-visuals': { ja: 'キービジュアル', en: 'Key visuals' },
  anniversary: { ja: '記念日・誕生日', en: 'Anniversary & birthday' },
  music: { ja: 'ジャケット', en: 'Music jackets' },
  collabs: { ja: 'コラボ', en: 'Collabs' },
  designer: { ja: 'がおう先生のアート', en: 'Designer art (Gaou)' },
  concept: { ja: '設定画', en: 'Concept sheets' },
  '3d': { ja: '3D', en: '3D' },
  aquarium: { ja: 'あくありうむ。', en: 'AQUARIUM.' },
};
const ORDER = [
  'outfits',
  'key-visuals',
  'anniversary',
  'music',
  'collabs',
  'designer',
  'concept',
  '3d',
  'aquarium',
] as const;
const all = await getCollection('arts');
const sections = await Promise.all(
  ORDER.filter((s) => (ART_SECTIONS as readonly string[]).includes(s)).map(async (id) => {
    const items = all
      .filter((a) => a.data.section === id)
      .sort(
        (a, b) =>
          Number(b.data.featured) - Number(a.data.featured) ||
          (a.data.date ?? '').localeCompare(b.data.date ?? ''),
      );
    const withLarge = await Promise.all(
      items.map(async (a) => {
        const big = await getImage({
          src: a.data.image,
          width: Math.round(
            a.data.image.width * Math.min(1, 1600 / Math.max(a.data.image.width, a.data.image.height)),
          ),
          format: 'webp',
          quality: 76,
        });
        return { a, srcset: '', href: big.src };
      }),
    );
    return { id, label: SECTION[id]!, items: withLarge };
  }),
);
let eager = 4;
// the deep band (FULL-UPDATE-PLAN §A2): the featured pieces, oldest first, as a strip of prints
const featured = all
  .filter((a) => a.data.featured)
  .sort((a, b) => (a.data.date ?? '').localeCompare(b.data.date ?? ''));
const featuredLarge = await Promise.all(
  featured.map(async (a) => ({
    a,
    href: (
      await getImage({
        src: a.data.image,
        width: Math.round(
          a.data.image.width * Math.min(1, 1600 / Math.max(a.data.image.width, a.data.image.height)),
        ),
        format: 'webp',
        quality: 76,
      })
    ).src,
  })),
);
// banners crop a wide strip out of each section's first piece: on tall (full-body) art aim near the
// top, where the face is, instead of the torso (FULL-UPDATE-PLAN §A2)
const bannerFocus = (img: { width: number; height: number }) =>
  img.height > img.width * 1.2 ? '50% 10%' : '50% 30%';
---

<Page
  chapter="arts"
  description="湊あくあの公式アートを、作者クレジットつきで集めたギャラリー。A credited gallery of Minato Aqua's official art: outfits, anniversaries, jackets and collaborations."
  h1="Arts"
  subtitle="アート"
  intro={{
    ja: `衣装、記念日、ジャケット、コラボ、そしてキャラクターデザインのがおう先生の絵。${all.length}点の公式アートを、すべて作者と出典つきで並べています。`,
    en: `Outfits, anniversaries, music jackets, collaborations and art by her character designer Gaou — ${all.length} pieces of official art, every one credited with its artist and source.`,
  }}
  vert={{ small: 'CG GALLERY', text: 'あくあーと', em: 'ギャラリー' }}
  marquee={[
    '#あくあーと',
    'CG GALLERY',
    'THANK YOU ARTISTS',
    'がおう',
    '© COVER Corp.',
    'CREDIT EVERY ARTIST',
    '⚓',
  ]}
>
  <Fragment slot="visual">
    <div class="arts-visual" aria-hidden="true">
      {sections[0]!.items.slice(0, 3).map(({ a }, i) => (
        <span class={`polaroid polaroid--${i}`}>
          <Picture
            fallbackFormat="webp"
            src={a.data.image}
            formats={['avif', 'webp']}
            widths={[280, 420]}
            width={420}
            sizes="220px"
            alt=""
            loading="eager"
          />
          <span class="pin" aria-hidden="true">
            <svg>
              <use href="#i-pin" />
            </svg>
          </span>
        </span>
      ))}
    </div>
  </Fragment>

  <div class="wrap">
    <aside class="art-banner card card--dashed" aria-label="Art policy">
      <Icon name="bow" />
      <p>
        <span data-l="ja" lang="ja">
          すべてのアートワークの権利はCOVER株式会社および各作者に帰属します。非営利のファンアーカイブとして、クレジットつきで掲載しています。転載する場合は必ず作者と出典を明記してください。
        </span>
        <span data-l="en" lang="en">
          All artwork © COVER Corp. and the credited artists. Shown here as a non-profit tribute with credit;
          please don't repost without crediting the artist and source.
        </span>
      </p>
    </aside>
  </div>

  <section class="section wrap band" aria-labelledby="featured-title">
    <SectionTitle no="01" en="Featured" ja="えらびぬきの10枚" id="featured-title" />
    <ol class="prints" role="list">
      {featuredLarge.map(({ a, href }, i) => (
        <li class="print" style={`--tilt:${[-1.5, 1, -0.5, 1.5, -1][i % 5]}deg`}>
          <a
            class="print__link"
            href={href}
            data-lb="image"
            data-group="featured"
            data-id={a.id}
            data-alt={`${a.data.alt.ja} / ${a.data.alt.en}`}
            data-title={[a.data.title.ja, a.data.title.en].filter(Boolean).join(' / ')}
            data-credit={`${a.data.artist} · ${a.data.credit}`}
            data-source={a.data.source}
            data-event="art_open"
          >
            <Image
              src={a.data.image}
              alt={`${a.data.alt.ja} / ${a.data.alt.en}`}
              height={240}
              densities={[1, 2]}
              loading="lazy"
            />
          </a>
          <span class="print__cap">
            <b>
              {a.data.title.ja && (
                <span data-l="ja" lang="ja">
                  {a.data.title.ja}
                </span>
              )}
              <span data-l="en" lang="en">
                {a.data.title.en ?? a.data.title.ja}
              </span>
            </b>
            <span class="credit">{a.data.artist}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>

  <div class="topbar-slot art-nav-slot">
    <nav class="art-nav" aria-label="Gallery sections" data-art-nav data-topbar>
      <ul role="list" data-topbar-primary>
        {sections.map((s) => (
          <li>
            <a class="ribbon-tab" href={`#${s.id}`} data-section-link={s.id}>
              <span lang="ja">{s.label.ja}</span>
              <small lang="en">{s.label.en}</small>
              <span class="count">{s.items.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="wrap gallery" data-gallery>
    {sections.map((s, si) => (
      <section class="gallery__sec" id={s.id} aria-labelledby={`h-${s.id}`} data-section={s.id}>
        <div class="gallery__banner">
          {s.items[0] && (
            <Image
              class="gallery__banner-img"
              src={s.items[0].a.data.image}
              alt=""
              width={1200}
              quality={55}
              loading="lazy"
              decoding="async"
              style={`object-position:${bannerFocus(s.items[0].a.data.image)}`}
            />
          )}
          <h2 class="gallery__title" id={`h-${s.id}`}>
            <span class="label">
              <b>{String(si + 1).padStart(2, '0')}</b>
            </span>
            <span lang="ja">{s.label.ja}</span>
            <small lang="en">{s.label.en}</small>
          </h2>
        </div>
        <ul class="art-masonry" role="list">
          {s.items.map(({ a, srcset, href }) => {
            const title = [a.data.title.ja, a.data.title.en].filter(Boolean).join(' / ');
            return (
              <li class="art-tile">
                <a
                  class="art-tile__link"
                  href={href}
                  data-lb="image"
                  data-group="arts"
                  data-id={a.id}
                  data-srcset={srcset || undefined}
                  data-alt={`${a.data.alt.ja} / ${a.data.alt.en}`}
                  data-title={title}
                  data-credit={`${a.data.artist} · ${a.data.credit}`}
                  data-source={a.data.source}
                  data-event="art_open"
                >
                  <Picture
                    fallbackFormat="webp"
                    src={a.data.image}
                    formats={['avif', 'webp']}
                    widths={[400, 800]}
                    width={800}
                    sizes="(max-width: 600px) 46vw, (max-width: 1200px) 30vw, 280px"
                    alt={`${a.data.alt.ja} / ${a.data.alt.en}`}
                    loading={eager-- > 0 ? 'eager' : 'lazy'}
                    class={`focal-${a.data.focal}`}
                  />
                </a>
                <span class="art-tile__cap">
                  <b>
                    {a.data.title.ja && (
                      <span data-l="ja" lang="ja">
                        {a.data.title.ja}
                      </span>
                    )}
                    <span data-l="en" lang="en">
                      {a.data.title.en ?? a.data.title.ja}
                    </span>
                  </b>
                  <span class="credit">
                    <b>{a.data.artist}</b> · {a.data.credit.split(' — ')[0]}
                    {a.data.date && <> · {dotDate(a.data.date)}</>}
                  </span>
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Page>

<script>
  import { onPage } from '../lib/lifecycle';
  import { track } from '../lib/analytics';
  // tiles "develop" from blurry to sharp as their image arrives
  onPage(() => {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery) return;
    gallery.classList.add('js-develop');
    const dev = (img: HTMLImageElement) => img.closest('.art-tile')?.classList.add('is-dev');
    gallery.querySelectorAll<HTMLImageElement>('.art-tile img').forEach((img) => {
      if (img.complete && img.naturalWidth) dev(img);
      else img.addEventListener('load', () => dev(img), { once: true });
      img.addEventListener('error', () => dev(img), { once: true });
    });
  });

  onPage(() => {
    const nav = document.querySelector<HTMLElement>('[data-art-nav]');
    if (!nav) return;
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
    links.forEach((a) =>
      a.addEventListener('click', () => track('art_section', { section: a.dataset.sectionLink })),
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).dataset.section;
          links.forEach((a) =>
            a.dataset.sectionLink === id
              ? a.setAttribute('aria-current', 'true')
              : a.removeAttribute('aria-current'),
          );
          // centre the current tab inside the menu's own sideways scroller — never scroll the page
          // (scrollIntoView would also move the window whenever the menu wasn't fully on screen)
          const link = nav.querySelector<HTMLElement>(`[data-section-link="${id}"]`);
          const strip = nav.querySelector<HTMLElement>('ul');
          if (link && strip) {
            const l = link.getBoundingClientRect();
            const r = strip.getBoundingClientRect();
            strip.scrollTo({
              left: strip.scrollLeft + (l.left - r.left) - (strip.clientWidth - l.width) / 2,
              behavior: document.documentElement.dataset.motion === 'on' ? 'smooth' : 'auto',
            });
          }
        }
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    document.querySelectorAll('[data-section]').forEach((s) => io.observe(s));
    return () => io.disconnect();
  });
</script>
