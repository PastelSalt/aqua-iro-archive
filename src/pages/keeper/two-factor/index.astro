---
import Keeper from '../../../layouts/Keeper.astro';
export const prerender = false;
---

<Keeper title="Two-factor" bare>
  <!-- novalidate: the 6-digit field must not block a backup code; the script checks whichever is filled -->
  <form class="k-auth k-card" data-verify novalidate>
    <h1>Enter your 6-digit code</h1>
    <div class="k-field">
      <label for="code">Authenticator code</label>
      <input id="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" />
    </div>
    <details>
      <summary>Use a backup code instead</summary>
      <div class="k-field">
        <label for="backup">Backup code</label>
        <input id="backup" autocomplete="off" />
      </div>
    </details>
    <p class="k-err" role="alert" hidden data-err></p>
    <button class="k-btn k-btn--navy" type="submit">
      Verify
    </button>
  </form>
</Keeper>

<script>
  import { authClient } from '../../../scripts/keeper-client';
  const form = document.querySelector<HTMLFormElement>('[data-verify]')!;
  const err = form.querySelector<HTMLElement>('[data-err]')!;
  const fail = (msg: string) => {
    err.textContent = msg;
    err.hidden = false;
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const code = (form.querySelector('#code') as HTMLInputElement).value.replace(/\s/g, '');
    const backup = (form.querySelector('#backup') as HTMLInputElement).value.trim();
    if (!backup && !/^\d{6}$/.test(code)) return fail('Enter the 6-digit code, or a backup code.');
    const { error } = backup
      ? await authClient.twoFactor.verifyBackupCode({ code: backup })
      : await authClient.twoFactor.verifyTotp({ code });
    if (!error) return void (location.href = '/keeper');
    if (error.status === 429) return fail('Too many attempts. Wait 10 minutes.');
    // a 5xx is the server failing to check the code (e.g. it cannot read the stored secret), not a wrong code
    if ((error.status ?? 0) >= 500)
      return fail(
        'The server could not check the code (a server problem, not a wrong code). Try again later.',
      );
    fail('That code did not work.');
  });
</script>
