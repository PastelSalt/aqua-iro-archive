---
/**
 * Settings (docs/KEEPER-UPDATE-PLAN.md §6.8): the board switches as toggles, the moderation numbers with plain
 * labels (the setting key shown small), and alerts. The word list and the account have their own pages.
 * Every change saves at once and is written to the audit log.
 */
import Keeper from '../../layouts/Keeper.astro';
import PageHead from '../../components/keeper/PageHead.astro';
import KIcon from '../../components/keeper/KIcon.astro';
import { dbTx } from '../../server/db/pool';
import { DEFAULTS, getSettings } from '../../server/settings';
import { ago, dateTime } from '../../lib/keeper-format';
export const prerender = false;
const s = await getSettings(dbTx() as never, true);
const NUMBERS: { title: string; items: [keyof typeof DEFAULTS, string, string][] }[] = [
  {
    title: 'Reports',
    items: [
      [
        'report_threshold',
        'Reports before a note hides',
        'Different visitors who must report a note before it hides for review',
      ],
      [
        'rereport_threshold',
        'Reports after an approval',
        'The same, for a note you have already approved once',
      ],
      ['rate_report_hour', 'Reports per visitor per hour', 'Limits report spam'],
    ],
  },
  {
    title: 'Posting limits',
    items: [
      ['rate_post_10m', 'Notes per visitor per 10 minutes', 'Counted by a hash of the visitor’s IP'],
      ['rate_post_day', 'Notes per visitor per day', 'The same, over 24 hours'],
      [
        'raid_posts_5m',
        'Busy-period trigger',
        'Notes across the whole site in 5 minutes that switch the newcomer hold on by itself',
      ],
      ['max_len', 'Longest note (characters)', 'Emoji and accented letters count as one'],
      ['max_lines', 'Most lines in a note', ''],
    ],
  },
  {
    title: 'Performance',
    items: [
      [
        'board_cache_s',
        'Board cache (seconds)',
        'How long the board list is cached at the edge; vercel.json also applies',
      ],
    ],
  },
];
---

<Keeper title="Settings" active="/keeper/settings">
  <PageHead
    title="Settings"
    icon="gear"
    hint="Changes save as soon as you make them and are written to the audit log."
  />

  <section class="k-card">
    <h2>
      <KIcon name="note" />
      Board switches
    </h2>
    <label class="k-switch">
      <input type="checkbox" data-bool="posting_paused" checked={s.posting_paused} />
      <span>
        <b>Pause posting</b>
        <small>
          The board shows “the board is resting today” and accepts no new notes. Reading and reporting still
          work.
        </small>
      </span>
    </label>
    <label class="k-switch">
      <input type="checkbox" data-bool="newcomer_hold" checked={s.newcomer_hold} />
      <span>
        <b>Newcomer hold</b>
        <small>
          Every new note waits in the Held queue until you approve it.
          {s.newcomer_hold_auto_at
            ? ` Switched on by the busy-period trigger ${ago(s.newcomer_hold_auto_at)}; the nightly clean-up switches it off after 24 quiet hours with nothing held.`
            : ''}
        </small>
      </span>
    </label>
    <p class="k-hint" style="margin-top:6px">
      Last nightly clean-up:{' '}
      {s.last_cron_at ? `${ago(s.last_cron_at)} (${dateTime(s.last_cron_at)})` : 'never'}
    </p>
  </section>

  <section class="k-card">
    <h2>
      <KIcon name="sliders-horizontal" />
      Moderation numbers
    </h2>
    {NUMBERS.map((g) => (
      <>
        <h3 class="k-group-title" style="margin:10px 0">
          <span>{g.title}</span>
        </h3>
        <div class="k-grid">
          {g.items.map(([key, label, help]) => (
            <label class="k-field">
              <span>{label}</span>
              <input
                type="number"
                min="0"
                data-num={key}
                value={String((s as Record<string, unknown>)[key])}
              />
              <small>
                {help}
                {help ? ' · ' : ''}
                <code>{key}</code> · default {String(DEFAULTS[key])}
              </small>
            </label>
          ))}
        </div>
      </>
    ))}
  </section>

  <section class="k-card">
    <h2>
      <KIcon name="paper-plane-tilt" />
      Alerts
    </h2>
    <p class="k-card__sub" style="margin:-4px 0 12px">
      Discord gets a message for: every sign-in step that passes, 5 failed sign-ins within an hour, a
      two-factor reset from the command line, the busy-period trigger, either board switch being flipped here,
      the daily digest (and the newcomer hold switching itself off), and a failed nightly clean-up.
    </p>
    <button type="button" class="k-btn" data-test-alert>
      <KIcon name="paper-plane-tilt" />
      Send a test alert
    </button>
  </section>
</Keeper>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '../../scripts/keeper/ui';
  document.querySelectorAll<HTMLInputElement>('[data-bool]').forEach((i) =>
    i.addEventListener('change', async () => {
      const { error } = await actions.keeper.settings({ key: i.dataset.bool!, value: i.checked });
      const name = i.closest('label')?.querySelector('b')?.textContent ?? i.dataset.bool;
      toast(error ? `Not saved: ${error.message}` : `${name}: ${i.checked ? 'on' : 'off'}`, {
        kind: error ? 'error' : 'ok',
      });
      if (error) i.checked = !i.checked;
    }),
  );
  document.querySelectorAll<HTMLInputElement>('[data-num]').forEach((i) =>
    i.addEventListener('change', async () => {
      const { error } = await actions.keeper.settings({ key: i.dataset.num!, value: Number(i.value) });
      const name = i.closest('label')?.querySelector('span')?.textContent ?? i.dataset.num;
      toast(error ? `Not saved: ${error.message}` : `${name}: ${i.value}`, { kind: error ? 'error' : 'ok' });
    }),
  );
  document.querySelector('[data-test-alert]')?.addEventListener('click', async () => {
    const { data } = await actions.keeper.testAlert();
    toast(data?.ok ? 'Test alert sent' : 'DISCORD_WEBHOOK_URL is not set', {
      kind: data?.ok ? 'ok' : 'error',
    });
  });
</script>
