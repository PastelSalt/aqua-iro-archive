---
/**
 * Moderation queue (docs/plans/KEEPER-UPDATE-PLAN.md §6.4): keyboard-first (J/K move · A approve · R remove ·
 * X select), bulk, 5 s undo — unchanged; laid out as Kotoha-style rows with a crew badge, status and reason
 * pills, reporters' notes as quotes, keycaps in the page head and a sticky bulk bar.
 */
import Keeper from '../../layouts/Keeper.astro';
import PageHead from '../../components/keeper/PageHead.astro';
import KIcon from '../../components/keeper/KIcon.astro';
import { dbTx } from '../../server/db/pool';
import { queue } from '../../server/board/moderation';
import { dateTime, ago, STATUS_LABEL, REASON_LABEL, heldReason } from '../../lib/keeper-format';
export const prerender = false;
const tab = Astro.url.searchParams.get('tab') === 'held' ? 'held' : 'reported';
const items = await queue(dbTx() as never, tab);
const REASON = ['Spam', 'Hate', 'Sexual', 'Personal info', 'Impersonation', 'Off-topic', 'Other'];
---

<Keeper title="Queue" active="/keeper/queue">
  <PageHead
    title="Queue"
    icon="tray"
    hint={
      tab === 'held'
        ? 'Notes held before they appeared: by the word list, a busy-period hold or the newcomer hold. Approve to publish.'
        : 'Notes visitors reported. Approving dismisses the reports; removing upholds them. Actions commit after 5 s.'
    }
  >
    <nav class="k-seg" aria-label="Queue tabs">
      <a href="/keeper/queue" aria-current={tab === 'reported' ? 'page' : undefined}>
        Reported
      </a>
      <a href="/keeper/queue?tab=held" aria-current={tab === 'held' ? 'page' : undefined}>
        Held
      </a>
    </nav>
  </PageHead>

  {items.length > 0 && (
    <div class="k-toolbar k-toolbar--sticky" data-bulk>
      <p class="k-keys" aria-label="Keyboard shortcuts">
        <span>
          <kbd>J</kbd>
          <kbd>K</kbd>move
        </span>
        <span>
          <kbd>A</kbd>approve
        </span>
        <span>
          <kbd>R</kbd>remove
        </span>
        <span>
          <kbd>X</kbd>select
        </span>
      </p>
      <span style="flex:1"></span>
      <button type="button" class="k-btn k-btn--sm" data-select-all>
        <KIcon name="check" />
        Select all
      </button>
      <button type="button" class="k-btn k-btn--sm k-btn--ok" data-bulk-approve>
        <KIcon name="check-circle" />
        Approve selected
      </button>
      <label class="k-field">
        <span class="k-sr">Reason for removing the selected notes</span>
        <select data-bulk-reason>
          {REASON.map((r) => (
            <option>{r}</option>
          ))}
        </select>
      </label>
      <button type="button" class="k-btn k-btn--sm k-btn--danger" data-bulk-remove>
        <KIcon name="x-circle" />
        Remove selected
      </button>
    </div>
  )}

  {items.length === 0 && (
    <div class="k-state k-state--calm">
      <KIcon name="check-circle" />
      <p>
        {tab === 'held'
          ? 'Nothing held. Every note is out on the board.'
          : 'Nothing reported. All calm on the board. ⚓'}
      </p>
    </div>
  )}

  <ol class="k-rows" data-queue>
    {items.map((m) => (
      <li class="k-row" data-id={m.id} data-crew={m.crew_no} tabindex="-1" aria-selected="false">
        <div style="display:grid;gap:8px;justify-items:center">
          <span class="k-row__crew">#{m.crew_no}</span>
          <input type="checkbox" class="k-row__check" aria-label={`Select note #${m.crew_no}`} data-check />
        </div>
        <div class="k-row__main">
          <p class="k-row__meta">
            <span class:list={['k-pill', m.status === 'visible' ? 'k-pill--navy' : 'k-pill--warn']}>
              {STATUS_LABEL[m.status] ?? m.status}
            </span>
            {m.held_reason && <span class="k-pill">held: {heldReason(m.held_reason)}</span>}
            {m.approved_at && <span class="k-pill k-pill--ok">approved before</span>}
            <time datetime={m.created_at} title={dateTime(m.created_at)}>
              {ago(m.created_at)} · {dateTime(m.created_at)}
            </time>
          </p>
          <p class="k-row__body">{m.body}</p>
          {m.reasons && (
            <p class="k-row__meta">
              <KIcon name="flag" />
              {m.reasons.map((r) => (
                <span class="k-pill k-pill--warn">
                  {REASON_LABEL[r.reason] ?? r.reason} ×{r.n}
                </span>
              ))}
            </p>
          )}
          {m.notes && (
            <ul class="k-row__quotes" aria-label="What reporters wrote">
              {m.notes.map((n) => (
                <li>“{n}”</li>
              ))}
            </ul>
          )}
        </div>
        <div class="k-row__actions">
          <button type="button" class="k-btn k-btn--sm k-btn--ok" data-approve>
            <KIcon name="check-circle" />
            Approve
          </button>
          <select aria-label={`Reason for removing #${m.crew_no}`} data-reason class="k-btn k-btn--sm">
            {REASON.map((r) => (
              <option>{r}</option>
            ))}
          </select>
          <button type="button" class="k-btn k-btn--sm k-btn--danger" data-remove>
            <KIcon name="x-circle" />
            Remove
          </button>
        </div>
      </li>
    ))}
  </ol>
</Keeper>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '../../scripts/keeper/ui';
  const list = document.querySelector<HTMLElement>('[data-queue]');
  const items = () => Array.from(document.querySelectorAll<HTMLElement>('[data-queue] .k-row:not(.is-done)'));
  let cur = 0;
  const focus = (i: number) => {
    const all = items();
    if (!all.length) return;
    cur = Math.max(0, Math.min(all.length - 1, i));
    all.forEach((x, j) => x.setAttribute('aria-selected', String(j === cur)));
    all[cur]!.focus();
  };
  function schedule(els: HTMLElement[], label: string, commit: (ids: string[]) => Promise<unknown>) {
    els.forEach((e) => e.classList.add('is-done'));
    let cancelled = false;
    const t = setTimeout(async () => {
      if (cancelled) return;
      try {
        await commit(els.map((e) => e.dataset.id!));
        els.forEach((e) => e.remove());
        if (!items().length) location.reload(); // show the empty state and the new badge counts
      } catch {
        els.forEach((e) => e.classList.remove('is-done'));
        toast('That failed, so nothing changed.', { kind: 'error' });
      }
    }, 5000);
    toast(label, () => {
      cancelled = true;
      clearTimeout(t);
      els.forEach((e) => e.classList.remove('is-done'));
    });
    focus(cur);
  }
  const crews = (els: HTMLElement[]) => els.map((e) => '#' + e.dataset.crew).join(', ');
  const approve = (els: HTMLElement[]) =>
    schedule(els, `Approved ${crews(els)}`, async (ids) => {
      const { error } = await actions.keeper.approve({ ids });
      if (error) throw error;
    });
  const remove = (els: HTMLElement[], reason: string) =>
    schedule(els, `Removed ${crews(els)} (${reason})`, async (ids) => {
      const { error } = await actions.keeper.remove({ ids, reason });
      if (error) throw error;
    });
  list?.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    const li = (e.target as HTMLElement).closest<HTMLElement>('.k-row');
    if (!li || !t) return;
    if (t.matches('[data-approve]')) approve([li]);
    if (t.matches('[data-remove]')) remove([li], li.querySelector<HTMLSelectElement>('[data-reason]')!.value);
  });
  const selected = () => items().filter((li) => li.querySelector<HTMLInputElement>('[data-check]')!.checked);
  document
    .querySelector('[data-select-all]')
    ?.addEventListener('click', () =>
      items().forEach((li) => (li.querySelector<HTMLInputElement>('[data-check]')!.checked = true)),
    );
  document
    .querySelector('[data-bulk-approve]')
    ?.addEventListener('click', () => selected().length && approve(selected()));
  document
    .querySelector('[data-bulk-remove]')
    ?.addEventListener(
      'click',
      () =>
        selected().length &&
        remove(selected(), document.querySelector<HTMLSelectElement>('[data-bulk-reason]')!.value),
    );
  document.addEventListener('keydown', (e) => {
    if (
      (e.target as HTMLElement).matches('input[type=text],textarea,select') ||
      e.metaKey ||
      e.ctrlKey ||
      e.altKey
    )
      return;
    const li = items()[cur];
    if (e.key === 'j') focus(cur + 1);
    else if (e.key === 'k') focus(cur - 1);
    else if (e.key === 'a' && li) approve([li]);
    else if (e.key === 'r' && li) remove([li], li.querySelector<HTMLSelectElement>('[data-reason]')!.value);
    else if (e.key === 'x' && li) {
      const c = li.querySelector<HTMLInputElement>('[data-check]')!;
      c.checked = !c.checked;
    } else return;
    e.preventDefault();
  });
  focus(0);
</script>
