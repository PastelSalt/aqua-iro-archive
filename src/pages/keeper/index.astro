---
/**
 * Keeper dashboard (docs/KEEPER-UPDATE-PLAN.md §6.1), after the Kotoha admin's: welcome card, what needs you,
 * the board, the archive, then visitors (fixed periods, chart, range details, grouped breakdowns) and a privacy
 * note. Board and archive render on the server; visitors load in the browser from /api/admin/stats.
 */
import { sql } from 'drizzle-orm';
import Keeper from '../../layouts/Keeper.astro';
import KIcon from '../../components/keeper/KIcon.astro';
import { dbTx } from '../../server/db/pool';
import { attention } from '../../server/board/moderation';
import { getSettings } from '../../server/settings';
import { labels } from '../../server/labels';
import { rows } from '../../server/db/types';
import { CHAPTERS } from '../../lib/chapters';
import { num, ago, dateTime, date, today } from '../../lib/keeper-format';
export const prerender = false;

const db = dbTx();
const [need, s, L, byStatus] = await Promise.all([
  attention(db as never),
  getSettings(db as never, true),
  labels(),
  db.execute(sql`SELECT status::text AS status, count(*)::int AS n,
      count(*) FILTER (WHERE status = 'removed' AND removed_at > now() - interval '30 days')::int AS recent
    FROM messages GROUP BY status`),
]);
const st = Object.fromEntries(
  rows<{ status: string; n: number; recent: number }>(byStatus).map((r) => [r.status, r]),
);
const n = (k: string) => st[k]?.n ?? 0;
const allNotes = n('visible') + n('held') + n('under_review') + n('removed');
const ARCHIVE = [
  { key: 'streams', label: 'Streams', icon: 'broadcast', href: '/streaming', newest: L.newest.streams },
  { key: 'clips', label: 'Clips', icon: 'scissors', href: '/clips', newest: L.newest.clips },
  { key: 'songs', label: 'Songs', icon: 'vinyl-record', href: '/discography', newest: L.newest.songs },
  { key: 'arts', label: 'Art', icon: 'palette', href: '/arts' },
  { key: 'events', label: 'Events', icon: 'sailboat', href: '/events', newest: L.newest.events },
  { key: 'talk', label: 'Talk scenes', icon: 'chats-circle', href: '/' },
] as const;
const pageTitles = Object.fromEntries(
  CHAPTERS.map((c) => [c.href.replace(/\/$/, '') || '/', `${c.title.en} (${c.href})`]),
);
const calm = need.reported + need.held + need.errors24 === 0;
---

<Keeper title="Dashboard" active="/keeper">
  <section class="k-card k-card--welcome">
    <div>
      <h1 class="k-ticket">
        <KIcon name="anchor" />
        Welcome back, keeper
      </h1>
      <p style="margin-top:10px">
        Everything on the archive at a glance: the board first, then the site and its visitors.
      </p>
    </div>
    <p class="k-date">
      <KIcon name="calendar-dots" />
      {today()}
    </p>
  </section>

  <section aria-labelledby="h-need">
    <h2 class="k-sr" id="h-need">
      Needs you
    </h2>
    <div class="k-attn">
      {need.reported > 0 && (
        <a class="k-alert k-alert--warn" href="/keeper/queue">
          <KIcon name="flag" />
          <span>
            <b>{need.reported}</b>
            <br />
            reported {need.reported === 1 ? 'note' : 'notes'}
          </span>
          <KIcon name="arrow-right" class="k-alert__go" />
        </a>
      )}
      {need.held > 0 && (
        <a class="k-alert k-alert--warn" href="/keeper/queue?tab=held">
          <KIcon name="pause-circle" />
          <span>
            <b>{need.held}</b>
            <br />
            held {need.held === 1 ? 'note' : 'notes'} to check
          </span>
          <KIcon name="arrow-right" class="k-alert__go" />
        </a>
      )}
      {need.errors24 > 0 && (
        <a class="k-alert k-alert--danger" href="/keeper/errors">
          <KIcon name="bug" />
          <span>
            <b>{need.errors24}</b>
            <br />
            {need.errors24 === 1 ? 'error' : 'errors'} in the last 24 h
          </span>
          <KIcon name="arrow-right" class="k-alert__go" />
        </a>
      )}
      {calm && (
        <p class="k-alert k-alert--calm">
          <KIcon name="check-circle" />
          <span>All calm: nothing reported, held or broken. ⚓</span>
        </p>
      )}
    </div>
  </section>

  <section aria-labelledby="h-board" style="display:grid;gap:14px">
    <div class="k-block-head">
      <h2 class="k-ticket k-ticket--sm" id="h-board">
        <KIcon name="note" />
        The board
      </h2>
      <p class="k-block-head__note">
        Posting <b>{s.posting_paused ? 'paused' : 'open'}</b> · newcomer hold{' '}
        <b>{s.newcomer_hold ? 'on' : 'off'}</b> · last clean-up{' '}
        {s.last_cron_at ? `${ago(s.last_cron_at)} (${dateTime(s.last_cron_at)})` : 'never'}
      </p>
    </div>
    <div class="k-tiles">
      <a class="k-tile" href="/keeper/notes?status=visible">
        <span class="k-tile__top">
          <span class="k-tile__icon">
            <KIcon name="eye" />
          </span>
          <KIcon name="arrow-right" class="k-tile__go" />
        </span>
        <span class="k-tile__label">Visible notes</span>
        <span class="k-tile__value">
          {num(n('visible'))}
          <small>of {num(allNotes)}</small>
        </span>
        <span class="k-split" aria-hidden="true">
          <i style={`width:${allNotes ? (n('visible') / allNotes) * 100 : 0}%`}></i>
        </span>
      </a>
      <a class:list={['k-tile', n('under_review') && 'k-tile--warn']} href="/keeper/queue">
        <span class="k-tile__top">
          <span class="k-tile__icon">
            <KIcon name="flag" />
          </span>
          <KIcon name="arrow-right" class="k-tile__go" />
        </span>
        <span class="k-tile__label">Under review</span>
        <span class="k-tile__value">{num(n('under_review'))}</span>
        <span class="k-tile__sub">hidden after reports</span>
      </a>
      <a class:list={['k-tile', n('held') && 'k-tile--warn']} href="/keeper/queue?tab=held">
        <span class="k-tile__top">
          <span class="k-tile__icon">
            <KIcon name="pause-circle" />
          </span>
          <KIcon name="arrow-right" class="k-tile__go" />
        </span>
        <span class="k-tile__label">Held</span>
        <span class="k-tile__value">{num(n('held'))}</span>
        <span class="k-tile__sub">waiting for approval</span>
      </a>
      <a class="k-tile k-tile--danger" href="/keeper/notes?status=removed">
        <span class="k-tile__top">
          <span class="k-tile__icon">
            <KIcon name="x-circle" />
          </span>
          <KIcon name="arrow-right" class="k-tile__go" />
        </span>
        <span class="k-tile__label">Removed (30 days)</span>
        <span class="k-tile__value">{num(st.removed?.recent ?? 0)}</span>
        <span class="k-tile__sub">{num(n('removed'))} removed in all</span>
      </a>
    </div>
    <section class="k-card">
      <div class="k-card__head">
        <div>
          <h2>
            <KIcon name="chart-bar" />
            Notes and reports
          </h2>
          <p class="k-card__sub" data-board-total>
            Last 30 days
          </p>
        </div>
      </div>
      <div
        class="k-chart-box"
        tabindex="0"
        data-board-chart
        aria-label="Notes and reports chart: use the left and right arrow keys to read each day"
      >
        <div class="k-skel" style="height:220px"></div>
      </div>
      <p class="k-legend k-legend--navy">
        <span>
          <i></i>Notes posted
        </span>
        <span>
          <i class="is-inner"></i>Reports
        </span>
      </p>
    </section>
  </section>

  <section aria-labelledby="h-archive" style="display:grid;gap:14px">
    <div class="k-block-head">
      <h2 class="k-ticket k-ticket--sm k-ticket--teal" id="h-archive">
        <KIcon name="archive" />
        The archive
      </h2>
      <p class="k-block-head__note">Built from the site's data files · each tile opens its page</p>
    </div>
    <div class="k-tiles">
      {ARCHIVE.map((a) => (
        <a class="k-tile k-tile--teal" href={a.href} target="_blank" rel="noopener">
          <span class="k-tile__top">
            <span class="k-tile__icon">
              <KIcon name={a.icon} />
            </span>
            <KIcon name="arrow-square-out" class="k-tile__go" />
          </span>
          <span class="k-tile__label">{a.label}</span>
          <span class="k-tile__value">{num(L.counts[a.key])}</span>
          <span class="k-tile__sub">{'newest' in a && a.newest ? `latest ${date(a.newest)}` : ' '}</span>
        </a>
      ))}
    </div>
  </section>

  <section style="display:grid;gap:14px" data-visitors data-titles={JSON.stringify(pageTitles)}></section>

  <p class="k-note">
    <KIcon name="shield-check" />
    <span>
      Visitor numbers are counted by the site itself: no cookies, IP addresses never stored, and the visitor
      hash changes every day. The board stores a salted hash of the poster's IP for 30 days (rate limits and
      reports), then deletes it. The Keeper itself is never counted.
    </span>
  </p>
</Keeper>

<script>
  import { renderVisitors, boardChart } from '../../scripts/keeper/visitors';
  import { num } from '../../lib/keeper-format';
  const host = document.querySelector<HTMLElement>('[data-visitors]')!;
  const box = document.querySelector<HTMLElement>('[data-board-chart]')!;
  let drawn = false;
  renderVisitors(host, {
    full: false,
    pageTitles: JSON.parse(host.dataset.titles ?? '{}'),
    onBoard: (r) => {
      if (drawn) return;
      drawn = true;
      boardChart(box, r.board.series);
      const t = r.board.series.reduce((a, d) => ({ n: a.n + d.notes, r: a.r + d.reports }), { n: 0, r: 0 });
      document.querySelector('[data-board-total]')!.textContent =
        `Last 30 days · ${num(t.n)} notes · ${num(t.r)} reports`;
    },
  });
</script>
