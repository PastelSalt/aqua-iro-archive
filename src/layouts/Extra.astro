---
/** Simple document layout for Credits, Privacy and other non-chapter pages. */
import Base from './Base.astro';
import CreditRails from '../components/chrome/CreditRails.astro';
import Stamp from '../components/ui/Stamp.astro';
import Seam from '../components/ui/Seam.astro';
import { Image } from 'astro:assets';
import pose from '../assets/poses/main-icon.webp';
import { SITE_NAME } from '../lib/site';
interface Props {
  title: { ja: string; en: string };
  label: string;
  description: string;
  noindex?: boolean;
}
const { title, label, description, noindex } = Astro.props;
// in-page index (FULL-UPDATE-PLAN §A2): built from the page's own section headings
const body = await Astro.slots.render('default');
const index = [...body.matchAll(/<h2[^>]*\bid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((m) => ({
  id: m[1]!,
  text: m[2]!
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim(),
}));
---

<Base
  title={`${title.ja} — ${title.en} | ${SITE_NAME}`}
  description={description}
  chapter="extra"
  noindex={noindex}
>
  <main id="main" class="extra" tabindex="-1">
    <CreditRails />
    <header class="page-head wrap extra-head">
      <div class="extra-head__art" aria-hidden="true">
        <Image src={pose} alt="" height={240} loading="eager" />
        <Stamp text="AQUA IRO ARCHIVE ⚓ CREDITS & POLICY ⚓ " size={110} />
      </div>
      <p class="label">
        <b>{label}</b>
      </p>
      <h1 lang="en">{title.en}</h1>
      <p class="subtitle" lang="ja">
        {title.ja}
      </p>
    </header>
    <Seam kind="wave" />
    <div class="wrap prose">
      {index.length > 2 && (
        <nav class="toc card" aria-label="Contents · 目次">
          <p class="label">
            <b>CONTENTS</b> · 目次
          </p>
          <ol role="list">
            {index.map((h) => (
              <li>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
      <Fragment set:html={body} />
    </div>
  </main>
</Base>
