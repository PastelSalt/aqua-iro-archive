{
  "name": "aqua-iro-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run data && astro check && astro build && tsx scripts/prune-assets.ts && tsx scripts/csp-hash.ts",
    "preview": "astro preview",
    "data": "tsx scripts/build-streams.ts && tsx scripts/validate-talk.ts",
    "images": "tsx scripts/prepare-images.ts",
    "import:rawdata": "tsx scripts/import-rawdata.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-laptop --project=visual-phone",
    "contrast": "tsx scripts/contrast-check.ts",
    "budget": "tsx scripts/check-budget.ts"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.16",
    "@justinribeiro/lite-youtube": "1.9.0",
    "@neondatabase/serverless": "1.2.0",
    "@phosphor-icons/core": "2.1.1",
    "@preact/signals": "2.11.3",
    "@vercel/functions": "3.10.2",
    "astro": "7.4.1",
    "better-auth": "1.7.12",
    "budoux": "0.10.0",
    "drizzle-orm": "0.45.4",
    "fuse.js": "7.5.0",
    "gsap": "3.15.0",
    "obscenity": "0.4.6",
    "preact": "11.0.1",
    "sharp": "0.35.5",
    "uplot": "1.6.32",
    "uqr": "0.1.3",
    "web-vitals": "6.2.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "otpauth": "9.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "path-to-regexp@<6.3.0": "6.3.0",
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
